{
  "name": "vgpu-react",
  "version": "0.3.0",
  "description": "React bindings for vgpu",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roprgm/vgpu-react.git"
  },
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc",
    "check": "biome check . && tsc -p tsconfig.test.json",
    "format": "biome format --write .",
    "test": "bun test",
    "prepublishOnly": "bun run check && bun run test:coverage && bun run build",
    "test:coverage": "bun test --coverage"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": ">=19",
    "vgpu": "^0.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@happy-dom/global-registrator": "^20.13.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vgpu": "^0.3.1"
  }
}
